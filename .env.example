DATABASE_URL="postgresql://fulfilment:fulfilment@localhost:5432/fulfilment?schema=public"
DASHBOARD_DEMO_MODE="true"
# Encrypts Shopify app secrets/tokens in the database. Generate: openssl rand -base64 32
# Use the SAME value everywhere that shares a database (local + Railway), or stored secrets can't be read.
ENCRYPTION_KEY=""
# Public URL of the deployed app; the Shopify redirect URL is APP_URL/api/shopify/callback.
APP_URL="http://localhost:3000"
# Hours between background Shopify syncs. 0 turns it off (recommended locally when pointed at production).
SHOPIFY_SYNC_HOURS="3"
