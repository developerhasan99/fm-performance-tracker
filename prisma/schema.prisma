generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum FulfillmentStatus {
  placed
  processing
  in_transit
  delivered
  delayed
  cancelled
  // Fulfilled order with nothing to ship (e.g. digital products).
  completed
}

enum IssueCategory {
  late_delivery
  not_dispatched
  lost_in_transit
  missing_item
  wrong_item
  damaged
  address_error
  cancellation
  other
}

enum IssueResolution {
  pending
  resolved
  refunded
  replacement
  reshipped
}

enum EventSource {
  shopify
  factory
  carrier
  support
}

model Order {
  id                 String             @id @default(cuid())
  // Shopify order name, e.g. "#1001". Only unique within a store.
  shopifyOrderId     String
  // Shopify GID (gid://shopify/Order/123). With storeId, this is the import dedup key.
  shopifyGid         String?
  storeId            String?
  store              ShopifyStore?      @relation(fields: [storeId], references: [id], onDelete: Restrict)
  customerName       String
  customerEmail      String
  market             String             @default("UK")
  currency           String             @default("GBP")
  factoryName        String
  carrier            String
  shippingService    String
  // First shipment's tracking; also the key for matching carrier status feeds later.
  trackingNumber     String?
  trackingUrl        String?
  orderDate          DateTime
  dispatchDueAt      DateTime
  deliveryDueAt      DateTime
  factoryReceivedAt  DateTime?
  pickedAt           DateTime?
  packedAt           DateTime?
  carrierCollectedAt DateTime?
  deliveredAt        DateTime?
  status             FulfillmentStatus  @default(placed)
  isSampleData       Boolean            @default(false)
  // False when no item needs shipping (digital products, memberships). Hidden from lists and metrics by default.
  requiresShipping   Boolean            @default(true)
  items              OrderItem[]
  contacts           SupportContact[]
  events             FulfillmentEvent[]
  tickets            SupportTicket[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([storeId, shopifyGid])
  @@index([shopifyOrderId])
  @@index([trackingNumber])
  @@index([orderDate])
  @@index([status, orderDate])
  @@index([requiresShipping, orderDate])
  @@index([factoryName, orderDate])
  @@index([carrier, orderDate])
}

model OrderItem {
  id              String @id @default(cuid())
  orderId         String
  sku             String
  name            String
  quantity        Int
  shippedQuantity Int
  unitPriceCents  Int
  order           Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model SupportContact {
  id                   String          @id @default(cuid())
  orderId              String
  category             IssueCategory
  resolution           IssueResolution @default(pending)
  channel              String          @default("email")
  contactedAt          DateTime
  refundAmountCents    Int             @default(0)
  replacementCostCents Int             @default(0)
  handlingMinutes      Int             @default(0)
  order                Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, contactedAt])
  @@index([category, contactedAt])
}

model FulfillmentEvent {
  id         String      @id @default(cuid())
  orderId    String
  source     EventSource
  eventType  String
  details    String?
  occurredAt DateTime
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, occurredAt])
}

// Only admins for now; add values here when scoped roles are needed.
enum Role {
  admin
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(admin)
  sessions     Session[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  // SHA-256 of the cookie token, so a database leak can't be replayed as a login.
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ShopifyStore {
  id                   String    @id @default(cuid())
  name                 String
  // Permanent store address, e.g. "acme.myshopify.com". Used for all API calls.
  shopDomain           String    @unique
  // Public storefront domain, e.g. "acme.com". Display only.
  customDomain         String?
  // Credentials of the store's custom-distribution app (Shopify Dev Dashboard). Secrets are encrypted.
  clientId             String
  clientSecret         String
  accessToken          String?
  accessTokenExpiresAt DateTime?
  refreshToken         String?
  // Orders created before this are never imported. Null = everything Shopify allows (last 60 days).
  importOrdersFrom     DateTime?
  dispatchSlaDays      Int       @default(2)
  deliverySlaDays      Int       @default(5)
  // Orders updated after this moment are fetched on the next sync.
  lastSyncedAt         DateTime?
  lastSyncError        String?
  orders               Order[]
  tickets              SupportTicket[]
  inboxes              SupportInbox[]
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

// A Commslayer workspace connected with an integration token (conversations:read).
model SupportAccount {
  id                    String          @id @default(cuid())
  name                  String
  // Commslayer's own account id (from GET /account); one connection per Commslayer account.
  externalAccountId     Int             @unique
  externalAccountName   String
  token                 String          // encrypted
  tokenExpiresAt        DateTime?
  // Conversations created before this are not imported.
  importFrom            DateTime
  lastSyncedAt          DateTime?
  lastSyncError         String?
  tickets               SupportTicket[]
  inboxes               SupportInbox[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
}

// One Commslayer conversation. Matching to orders comes later; `raw` keeps the full API response for analysis.
model SupportTicket {
  id               String         @id @default(cuid())
  accountId        String
  account          SupportAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  externalId       Int
  displayId        Int?
  status           String
  subject          String?
  inboxId          Int?
  contactId        Int?
  labels           String[]
  contactReason    String?
  contactReasonId  Int?
  ticketCreatedAt  DateTime
  ticketUpdatedAt  DateTime?
  lastActivityAt   DateTime?
  raw              Json
  // Spam, merged, review/system notifications: kept for analysis, left out of metrics and matching.
  excluded         Boolean        @default(false)
  category         IssueCategory?
  refundRequested  Boolean        @default(false)
  wismo            Boolean        @default(false)
  // 6+ digit numbers found in the subject (recomputed every sync) and in the customer's messages (fetched once).
  subjectNumbers   String[]
  messageNumbers   String[]
  messagesCheckedAt DateTime?
  // Set by matching: the order a number pointed to, and the store (from the order, else the inbox mapping).
  orderId          String?
  order            Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  storeId          String?
  store            ShopifyStore?  @relation(fields: [storeId], references: [id], onDelete: SetNull)
  matchMethod      String?
  importedAt       DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([accountId, externalId])
  @@index([ticketCreatedAt])
  @@index([orderId])
  @@index([storeId])
}

// Which store a Commslayer inbox belongs to (set by an admin); gives unmatched tickets a store.
model SupportInbox {
  id              String         @id @default(cuid())
  accountId       String
  account         SupportAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  externalInboxId Int
  storeId         String?
  store           ShopifyStore?  @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@unique([accountId, externalInboxId])
}
